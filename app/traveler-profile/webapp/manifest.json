{
  "_version": "1.65.0",
  "sap.app": {
    "id": "galactic.stays.travelerprofile",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/traveler/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.145.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "galactic.stays.travelerprofile.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TravelersList",
          "target": "TravelersList"
        },
        {
          "pattern": "Travelers({key}):?query:",
          "name": "TravelersObjectPage",
          "target": "TravelersObjectPage"
        }
      ],
      "targets": {
        "TravelersList": {
          "type": "Component",
          "id": "TravelersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Travelers",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "hideFilterBar": true,
              "navigation": {
                "Travelers": {
                  "detail": {
                    "route": "TravelersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "CreationDialog",
                      "creationFields": "firstName,lastName,dateOfBirth,species,birthPlanet_ID"
                    },
                    "personalization": false,
                    "enableExport": false,
                    "disableCopyToClipboard": true
                  }
                }
              }
            }
          }
        },
        "TravelersObjectPage": {
          "type": "Component",
          "id": "TravelersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Travelers",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
