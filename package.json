{
  "name": "galactic-stays",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10.11.0",
    "prettier": "3.9.9"
  },
  "scripts": {
    "start": "cds-serve",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "test": "node --test \"test/*.test.js\""
  },
  "cds": {
    "requires": {
      "swapi": {
        "kind": "rest",
        "credentials": {
          "url": "https://swapi.dev/api",
          "requestTimeout": 10000
        }
      },
      "auth": {
        "[development]": {
          "kind": "basic",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "lando": {
              "password": "lando",
              "roles": [
                "HotelManager"
              ]
            },
            "boba": {
              "password": "boba",
              "roles": [
                "HotelManager"
              ]
            },
            "anakin": {
              "password": "anakin",
              "roles": [
                "Traveler"
              ]
            },
            "padme": {
              "password": "padme",
              "roles": [
                "Traveler"
              ]
            },
            "*": false
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "private": true
}
