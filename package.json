{
  "name": "galactic-stays",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10.11.0",
    "prettier": "3.9.9"
  },
  "scripts": {
    "start": "cds-serve",
    "lint": "eslint .",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "test": "node --test"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "basic",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "anakin": {
              "password": "anakin",
              "roles": [
                "Traveler"
              ]
            },
            "padme": {
              "password": "padme",
              "roles": [
                "Traveler"
              ]
            },
            "*": false
          }
        }
      }
    }
  },
  "private": true
}
